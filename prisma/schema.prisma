// MiRutaFit — database schema (Prisma 7)
// Docs: docs/database.md
//
// The auth-related models (User, Session, Account, Verification) follow the
// schema expected by better-auth + its admin plugin. Do not rename their
// fields. Custom profile fields and app domain models are documented inline.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application user. Auth is handled by better-auth (email + password for now).
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String? // avatar URL (kept shallow for now)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // better-auth admin plugin.
  // `role` is a comma-separated list of roles (e.g. "user" or "user,admin").
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // Optional profile data (see better-auth additionalFields in src/lib/auth.ts).
  firstName String?
  lastName  String?
  country   String?
  phone     String?
  // Preferred UI language, set to the active locale when the account is created.
  language  String?

  sessions Session[]
  accounts Account[]

  @@map("user")
}

/// Active login session issued by better-auth.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // admin plugin: set when an admin impersonates this user.
  impersonatedBy String?

  @@map("session")
}

/// Credential / OAuth account linked to a user.
/// For email+password the hashed password lives in `password`.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

/// Key/value store for runtime configuration managed from the admin panel
/// (e.g. SMTP settings). Each row holds a JSON value under a string key.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_setting")
}

/// Short-lived verification tokens (email verification, password reset, etc.).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

/// One-time codes issued by the reusable verification-code module
/// (src/lib/verification-codes.ts). Used for password recovery now and other
/// flows later. The code itself is stored hashed, never in plaintext.
model VerificationCode {
  id         String    @id @default(cuid())
  identifier String // who the code is for, e.g. an email
  purpose    String // what it's for, e.g. "password_reset"
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
  @@map("verification_code")
}

/// A folder in the admin Media library (can be nested).
model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderTree")
  files     MediaFile[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("media_folder")
}

/// A file in the admin Media library. Stored on disk as `fileName` (uuid+ext);
/// `name` is the friendly display name. Private files are only served to admins.
model MediaFile {
  id        String   @id @default(cuid())
  name      String // display name
  fileName  String   @unique // uuid.ext on disk, also the /media/<fileName> slug
  mimeType  String
  size      Int // bytes
  isPublic  Boolean  @default(true)
  width     Int? // images/videos
  height    Int?
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId])
  @@map("media_file")
}

/// A configured widget instance from the Widget library (reusable across pages).
/// `type` maps to a definition in the widget registry (src/widgets); `config`
/// holds that widget's settings (shape depends on the type).
model Widget {
  id        String   @id @default(cuid())
  type      String // registry key, e.g. "slider" | "richText"
  name      String // admin-facing label
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("widget")
}

/// A composable page. `layout` is a JSON tree of rows -> columns (12-col grid)
/// -> widget instance ids. The home page has slug "home".
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  layout    Json     @default("{\"rows\": []}")
  status    String   @default("published") // future: draft | published
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("page")
}

/// A standalone static HTML page served verbatim at /static/<slug>, completely
/// outside the site layout/chrome/i18n. The admin pastes raw HTML (or uploads an
/// .html file) and it is returned as-is by a route handler. See docs/static-pages.md.
model StaticPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String   @default("") // admin-facing label only (not shown to visitors)
  html      String   @default("") // raw HTML, served exactly as stored
  published Boolean  @default(true) // unpublished -> 404
  // When true, this page also shows the maintenance notice while maintenance
  // mode is on (admins still see it). Default: unaffected by maintenance.
  respectMaintenance Boolean @default(false)
  // Send a Telegram notification when this page is visited (see docs/notifications.md).
  notifyViews Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("static_page")
}

/// Shared taxonomy term (categories and tags), reusable across the app.
/// `kind` distinguishes them; `key` is a stable snake_case id; labels are
/// per-locale (see TaxonomyTranslation). See docs/articles.md.
model Taxonomy {
  id        String   @id @default(cuid())
  kind      String // "category" | "tag"
  key       String // snake_case
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations TaxonomyTranslation[]
  articles     Article[]             @relation("ArticleTaxonomies")

  @@unique([kind, key])
  @@index([kind])
  @@map("taxonomy")
}

/// Per-locale human label for a taxonomy term.
model TaxonomyTranslation {
  id         String   @id @default(cuid())
  taxonomyId String
  taxonomy   Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  locale     String
  label      String

  @@unique([taxonomyId, locale])
  @@map("taxonomy_translation")
}

/// A blog article ("Artículos"). Shared across locales: cover image, taxonomies,
/// dates, status. Per-locale content lives in ArticleTranslation. See
/// docs/articles.md.
model Article {
  id          String     @id @default(cuid())
  coverImage  String? // media fileName (widget + SEO)
  status      String     @default("draft") // "draft" | "published"
  publishedAt DateTime? // drives the YYYY-MM-DD url segment + ordering
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  translations ArticleTranslation[]
  taxonomies   Taxonomy[]           @relation("ArticleTaxonomies")

  @@index([status])
  @@map("article")
}

/// A message sent through a public contact widget. `mode` distinguishes the
/// two contact flows (a regular visitor vs. a brand/sponsor). Read state is
/// tracked so the admin inbox can mark messages as read. See docs/contact.md.
model ContactMessage {
  id        String    @id @default(cuid())
  mode      String    @default("person") // "person" | "brand"
  name      String
  email     String
  phone     String?
  topic     String?
  subject   String
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_message")
}

/// A survey/form the admin builds and publishes at /encuestas/<slug>.
/// Questions are grouped by their `section` label; responses are collected as
/// SurveyResponse + SurveyAnswer rows. See docs/surveys.md.
model Survey {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("") // intro shown above the form
  disclaimer  String   @default("") // optional highlighted warning box
  submitText  String   @default("") // thank-you message after submitting
  status      String   @default("draft") // "draft" | "open" | "closed"
  // Telegram notifications (see docs/notifications.md).
  notifyViews     Boolean @default(false) // notify when the survey page is visited
  notifyResponses Boolean @default(false) // notify + attach a PDF when someone responds
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@map("survey")
}

model SurveyQuestion {
  id       String  @id @default(cuid())
  surveyId String
  survey   Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  section  String  @default("") // section heading this question belongs to
  type     String // short_text | long_text | single_choice | multiple_choice | scale | number
  label    String
  help     String  @default("") // helper / example text
  required Boolean @default(false)
  options  Json    @default("{}") // choices[] for choice types; {min,max,minLabel,maxLabel} for scale
  order    Int     @default(0)

  answers SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_question")
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  answers SurveyAnswer[]

  @@index([surveyId])
  @@map("survey_response")
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String         @default("") // free text / choice / scale; multiple_choice = JSON array

  @@index([responseId])
  @@map("survey_answer")
}

/// A public community comment / testimonial. Visitor-submitted comments start
/// as `pending` and only appear on the wall once `approved` (unless auto-approve
/// is on). `source` distinguishes visitor comments from admin-seeded ones.
/// See docs/community.md.
model Comment {
  id          String   @id @default(cuid())
  name        String
  message     String
  avatarColor String   @default("#10b981")
  status      String   @default("pending") // "pending" | "approved" | "hidden"
  source      String   @default("community") // "community" | "admin"
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("comment")
}

/// Anecdotal view counter, keyed by a stable string:
///   "page:home", "page:articles", "article:<id>", "survey:<id>".
/// Incremented from the client (once per session per key). See src/lib/views.ts.
model PageView {
  key       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("page_view")
}

/// Per-locale content for an article.
model ArticleTranslation {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  slug        String
  description String   @default("") // short excerpt
  body        String   @default("") // rich HTML from the editor
  updatedAt   DateTime @updatedAt

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@map("article_translation")
}
