# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
# In EasyPanel, set these as environment variables of the service.
# ─────────────────────────────────────────────────────────────

# Database connection string (PostgreSQL 17).
# Local: points to the docker-compose Postgres service.
# Production (EasyPanel): use the internal connection string of your DB service.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth (better-auth)
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="change-me"
# The canonical URL the app is served from (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL exposed to the browser (usually same as BETTER_AUTH_URL).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Emails that are always promoted to admin on signup (comma separated).
ADMIN_EMAILS="admin@mirutafit.com,sluy1283@gmail.com"
